generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id       String  @id
  name     String
  color    String
  order    Int     @default(0)
  blocks   Block[]
  tasks    Task[]
  rhythms  Rhythm[]
}

/// A recurring rule. Never rendered directly — materialised into Blocks per day.
model Rhythm {
  id        String   @id @default(cuid())
  title     String
  startMin  Int
  endMin    Int
  days      Int[]                     // 0 = Sunday
  fixed     Boolean  @default(true)
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  createdAt DateTime @default(now())
}

/// A concrete instance on a concrete date. Edits here never touch the Rhythm.
model Block {
  id        String   @id @default(cuid())
  date      String                    // YYYY-MM-DD, local
  title     String
  /// The one concrete line Focus opens with. Postgres can enforce NOT NULL but
  /// not "concrete", so "" is the explicit unset state: Focus never renders an
  /// empty objective, it proposes instead.
  objective String   @default("")
  /// Cached generated brief. Null until Focus generates one.
  brief     Json?
  /// What you are working from this session: a chapter, a paper, a drill.
  /// Free text you write, never a library reference.
  material  String   @default("")
  /// Session notes, written in Focus while the block is open.
  notes     String   @default("")
  startMin  Int
  endMin    Int
  /// Session clock. `elapsedSec` is time already banked; `startedAt` is set
  /// while the clock is running and null while it is paused. Elapsed is always
  /// elapsedSec + (now - startedAt), so a refresh cannot lose or invent time
  /// and the browser clock is never the authority.
  elapsedSec Int     @default(0)
  startedAt DateTime?
  fixed     Boolean  @default(false)
  source    String   @default("me")   // me | template | jarvis
  status    String   @default("pending") // pending | done | missed
  rhythmId  String?
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  createdAt DateTime @default(now())
  @@index([date])
}

/// Records that a date has been built from the template, so we never rebuild over edits.
model DayStamp {
  date      String   @id
  builtAt   DateTime @default(now())
}

model InboxItem {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
}

model Task {
  id        String   @id @default(cuid())
  title     String
  energy    String   @default("any")  // deep | admin | light | any
  est       Int      @default(30)
  done      Boolean  @default(false)
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String
  text      String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// TARA Drill
// ---------------------------------------------------------------------------

/// One multiple-choice question, kept for good.
///
/// The bank is the point: a question is written once and then drilled,
/// re-drilled and reviewed against the attempt history below. Nothing here is
/// discarded after a session, which is why `retired` exists — a question that
/// turns out to be wrong is hidden, not deleted, so the attempts that
/// reference it keep their meaning.
model TaraQuestion {
  id          String   @id @default(cuid())
  module      String                      // ct | ps
  subcategory String                      // a leaf id from the taxonomy
  /// The stimulus: an argument for Critical Thinking, a scenario or data for
  /// Problem Solving. Empty only where the stem is self-contained.
  passage     String   @default("")
  /// The question itself, asked separately from the passage the way the real
  /// paper asks it.
  stem        String
  /// Exactly five: [{ label: "A", text: "..." }, ...].
  options     Json
  answer      String                      // A | B | C | D | E
  /// Why the key is right. Written to be read after answering, not before.
  why         String
  /// How you were meant to get there. For Problem Solving this is the
  /// calculator-free route in at most three steps, which is what makes the
  /// no-calculator rule checkable rather than merely asserted; for Critical
  /// Thinking it is the argument's skeleton in letters.
  route       String   @default("")
  /// Why each of the other four fails, keyed by label: { "B": "...", ... }.
  /// Every wrong option names the specific mistake that produces it — that is
  /// what makes a distractor teach rather than merely fill a slot.
  distractors Json
  difficulty  String   @default("medium")  // easy | medium | hard
  /// generated | real. Real questions are TSA past-paper items entered by
  /// hand and are the volume source; generated ones fill the gaps.
  origin      String   @default("generated")
  /// Where a real question came from, e.g. "TSA 2019 S1 Q12".
  source      String?
  /// For Critical Thinking: the flaw-catalogue key the question turns on.
  flaw        String?
  retired     Boolean  @default(false)
  createdAt   DateTime @default(now())
  attempts    TaraAttempt[]

  @@index([module, subcategory])
  @@index([origin])
}

/// One answer to one question. Never overwritten — the history is the progress
/// view, and "answered correctly twice" is a count over these rows.
model TaraAttempt {
  id         String       @id @default(cuid())
  question   TaraQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  /// A | B | C | D | E, or null for a question left blank. There is no
  /// negative marking, so a skip is never the right move and is recorded as
  /// its own thing rather than as a wrong answer.
  chosen     String?
  correct    Boolean      @default(false)
  seconds    Int          @default(0)
  mode       String       @default("practice") // practice | timed | mock | weakness | review
  createdAt  DateTime     @default(now())

  @@index([questionId])
  @@index([createdAt])
}

/// A writing-task prompt in the official shape: a statement, then the three
/// questions that are always asked of it.
model TaraPrompt {
  id        String      @id @default(cuid())
  statement String
  q1        String
  q2        String
  q3        String
  origin    String      @default("generated")
  createdAt DateTime    @default(now())
  essays    TaraEssay[]
}

/// One attempt at one prompt, with its marking.
model TaraEssay {
  id          String     @id @default(cuid())
  prompt      TaraPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  promptId    String
  text        String     @default("")
  words       Int        @default(0)
  seconds     Int        @default(0)
  submitted   Boolean    @default(false)
  /// The structured mark: per-criterion verdicts, the typo list, the overall
  /// read. Null until it has been marked.
  mark        Json?
  /// A 750-word answer to the same prompt, written after marking so it can be
  /// held against what was actually written.
  exemplar    String?
  /// [{ mine, alternative, note }] — where the essay diverged from the model
  /// answer, quoting both sides.
  divergences Json?
  createdAt   DateTime   @default(now())

  @@index([promptId])
}

// ---------------------------------------------------------------------------
// The PPE interview drill
// ---------------------------------------------------------------------------

/// One interview prompt. Not an essay title — a claim to interrogate, a
/// counterintuitive result, or an ethical case, of the kind a tutor opens with.
///
/// Topics are written ahead of time and drawn from rather than generated on
/// demand, because "press start and wait ninety seconds" is not how you build
/// the habit of sitting down to practise.
model InterviewTopic {
  id        String   @id @default(cuid())
  strand    String                      // philosophy | politics | economics
  kind      String                      // claim | result | case
  /// The prompt as a tutor would say it, out loud, in one or two sentences.
  prompt    String
  /// The one line of context a tutor would have in front of them.
  context   String   @default("")
  /// What this is actually testing. Never shown before the answer.
  tests     String   @default("")
  /// Set the first time it is used. An unseen topic is one where this is null.
  usedAt    DateTime?
  createdAt DateTime @default(now())
  sessions  InterviewSession[]

  @@index([strand])
  @@index([usedAt])
}

/// One sitting: prep, answer, critique, follow-up, critique again.
model InterviewSession {
  id        String         @id @default(cuid())
  topic     InterviewTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicId   String
  /// Frozen copies, so a session reads the same forever even if the topic
  /// pool is rewritten underneath it.
  strand    String
  prompt    String
  context   String         @default("")
  /// Written during prep, kept afterwards — the critique reads them, because
  /// what you planned to say and what you said are different failures.
  notes     String         @default("")
  prepSec   Int            @default(0)
  /// prep | answering | marking | round1 | followup | done
  stage     String         @default("prep")
  /// The single biggest weakness across both rounds, and the one thing to do
  /// differently. Written at the end of round two, because that is where the
  /// real assessment is.
  weakness  String?
  nextTime  String?
  createdAt DateTime       @default(now())
  rounds    InterviewRound[]

  @@index([createdAt])
}

/// One answer and its critique. Round 1 is the opening question; round 2 is the
/// tutor's push-back on what you actually said.
model InterviewRound {
  id         String           @id @default(cuid())
  session    InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String
  n          Int                            // 1 | 2
  /// What was asked. Round 1 is the prompt; round 2 is the tutor's follow-up,
  /// written against the transcript of round 1.
  question   String
  transcript String           @default("")
  seconds    Int              @default(0)
  /// { structure: 6, reasoning: 5, evidence: 4, responsiveness: 7, delivery: 5 }
  /// Flat integers so a trend is a query rather than a parse.
  scores     Json?
  /// The whole marking: where it collapsed, the hedges quoted back, how to
  /// have prepared, what could have been said, the divergences.
  critique   Json?
  /// A full answer at the length you were asked to speak for. Prose, never
  /// bullets — the point is to hear what it sounds like.
  modelAnswer String?
  /// [{ title, author, url, why }] — every one confirmed by search, because a
  /// misattributed argument is worse than no argument.
  sources    Json?
  createdAt  DateTime         @default(now())

  @@index([sessionId])
}
