# Your Railway API URL, e.g. https://cadence-server-production.up.railway.app
NEXT_PUBLIC_API_URL="http://localhost:8080"

# Must match CADENCE_TOKEN on the server exactly.
NEXT_PUBLIC_CADENCE_TOKEN="change-me-to-something-long-and-random"

# Set to true to enable /dev/ui, the primitive gallery. Leave unset in production.
NEXT_PUBLIC_ENABLE_DEV_UI="false"
