# Railway injects DATABASE_URL automatically once you attach a Postgres service.
DATABASE_URL="postgresql://user:pass@host:5432/railway"

# Paste your Anthropic key here. It never reaches the browser.
ANTHROPIC_API_KEY="sk-ant-..."

# Any long random string. Must match NEXT_PUBLIC_CADENCE_TOKEN on the web app.
CADENCE_TOKEN="change-me-to-something-long-and-random"

# Your Vercel URL, e.g. https://cadence-ibrahim.vercel.app
CORS_ORIGIN="http://localhost:3000"
PORT=8080
