generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id       String  @id
  name     String
  color    String
  order    Int     @default(0)
  blocks   Block[]
  tasks    Task[]
  rhythms  Rhythm[]
}

/// A recurring rule. Never rendered directly — materialised into Blocks per day.
model Rhythm {
  id        String   @id @default(cuid())
  title     String
  startMin  Int
  endMin    Int
  days      Int[]                     // 0 = Sunday
  fixed     Boolean  @default(true)
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  createdAt DateTime @default(now())
}

/// A concrete instance on a concrete date. Edits here never touch the Rhythm.
model Block {
  id        String   @id @default(cuid())
  date      String                    // YYYY-MM-DD, local
  title     String
  startMin  Int
  endMin    Int
  fixed     Boolean  @default(false)
  source    String   @default("me")   // me | template | jarvis
  status    String   @default("pending") // pending | done | missed
  rhythmId  String?
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  createdAt DateTime @default(now())
  @@index([date])
}

/// Records that a date has been built from the template, so we never rebuild over edits.
model DayStamp {
  date      String   @id
  builtAt   DateTime @default(now())
}

model InboxItem {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
}

model Task {
  id        String   @id @default(cuid())
  title     String
  energy    String   @default("any")  // deep | admin | light | any
  est       Int      @default(30)
  done      Boolean  @default(false)
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String
  text      String
  createdAt DateTime @default(now())
}
